config("_avx_config") {
    cflags = [
        "-mavx",
        "-mpclmul",
    ]
}

config("_avx2_config") {
    cflags = [
        "-mavx2",
        "-mfma",
        "-mbmi",
        "-mbmi2",
    ]
}

config("_avx512_config") {
    cflags = [
        "-mavx512bw",
        "-mavx512cd",
        "-mavx512dq",
        "-mavx512f",
        "-mavx512vl",
        "-mvpclmulqdq",
    ]
}

_src_root = string_replace(string_replace(rebase_path("//.", root_build_dir) + "/", "/./", "/"), "//", "/")
_gen_root = string_replace(rebase_path(root_gen_dir, root_build_dir) + "/", "//", "/")
_abs_src_root = string_replace(string_replace(rebase_path("//.") + "/", "/./", "/"), "//", "/")

config("path_prefix_map") {
    cflags = [
        "-ffile-prefix-map=${_abs_src_root}=",
        "-ffile-prefix-map=${_src_root}=",
        "-ffile-prefix-map=${_gen_root}=",
        "-fdebug-compilation-dir=.",
    ]
}

config("cpu_baseline") {
    cflags = [
        "-msse2",
        "-msse3",
        "-mssse3",
        "-msse4.1",
        "-msse4.2",
        "-mpopcnt",
        "-mcx16",
    ]
}

config("base") {
    cflags = [
        "-pipe",
        "-Wall",
        "-Werror",
        "-Wsign-compare",
        "-Wno-unknown-warning-option",

        # some disrespected common warnings
        "-Wno-format",
        "-Wno-format-security",
        "-Wno-logical-op-parentheses",
        "-Wno-parentheses",
        "-Wno-vla-cxx-extension",

        # clang 18+ warnings that ya turns off in build/conf/compilers/gnu_compiler.conf
        "-Wno-array-parameter",
        "-Wno-deprecate-lax-vec-conv-all",
        "-Wno-unqualified-std-cast-call",
        "-Wno-unused-but-set-parameter",
        "-Wno-implicit-function-declaration",
        "-Wno-int-conversion",
        "-Wno-incompatible-function-pointer-types",
        "-Wno-address-of-packed-member",
        "-Wno-deprecated-this-capture",
        "-Wno-missing-designated-field-initializers",
        "-Wno-invalid-offsetof",

        # clang 20+ warnings that ya turns off in the same conf
        "-Wno-alias-template-in-declaration-name",
        "-Wno-cast-function-type-mismatch",
        "-Wno-explicit-specialization-storage-class",
        "-Wno-extraneous-template-head",
        "-Wno-missing-template-arg-list-after-template-kw",
        "-Wno-nontrivial-memcall",
        "-Wno-strict-primary-template-shadow",

        # every function and object in its own section, for --gc-sections
        "-ffunction-sections",
        "-fdata-sections",
    ]

    cflags_cc = [
        "-std=c++20",
        "-fsized-deallocation",

        # don't export inline functions from every shared library:
        # shrinks .dynsym/.dynstr, PLT and dynamic relocations
        "-fvisibility-inlines-hidden",
    ]

    include_dirs = [
        "//",
        "$root_gen_dir",
    ]
}

config("no_stdlibs") {
    cflags_cc = [ "-nostdinc++" ]

    ldflags = [ "-nodefaultlibs" ]

    libs = [
        "c",
        "dl",
        "m",
        "pthread",
        "rt",
    ]
}

config("debug_info") {
    cflags = [
        "-g",
        # keep DWARF in .dwo files next to objects instead of linking it into .so
        "-gsplit-dwarf",
        # no template arguments in DW_AT_name - debugger rebuilds them
        "-gsimple-template-names",
        # with -gsplit-dwarf clang writes the whole command line into .dwo, so any
        # flag that doesn't affect codegen (-ftime-trace, -W*, ...) changes it
        "-gno-record-command-line",
    ]

    if (debug_compression != "none") {
        cflags += [ "-gz=$debug_compression" ]
        ldflags = [ "-Wl,--compress-debug-sections=$debug_compression" ]
    }
}

config("debug") {
    cflags = [
        "-O0",
    ]

    configs = [ ":debug_info" ]
}

config("relwithdebinfo") {
    cflags = [
        "-O3",
        "-UNDEBUG",
    ]

    configs = [ ":debug_info" ]
}

config("time_trace") {
    cflags = [
        "-ftime-trace",
        "-ftime-trace-granularity=$time_trace_granularity",
    ]
}

# pch_mode = "per_target": as //build/gn/pch/global builds the shared ones --
# reproducible, relocatable against the source root -- for the precompiled
# header of a target and its files (the cc1 spelling: unused by a file)
config("pch") {
    cflags_cc = [
        "-fpch-instantiate-templates",
        "-Xclang",
        "-relocatable-pch",
        "-Xclang",
        "-fno-pch-timestamp",
        "-isysroot",
        string_replace(string_replace(rebase_path("//.") + "/", "/./", "/"), "//", "/"),
    ]
}

config("release") {
    cflags = [
        "-fomit-frame-pointer",
        "-O3",
    ]

    defines = [ "NDEBUG" ]
}

config("shared_library") {
    cflags = [
        "-fPIC",
    ]
    # A library's own (non-weak) functions -- its calls, its vtables -- bound
    # within it, not looked up in the ~2000 libraries a program loads: most of
    # its startup otherwise. Weak ones (Y_WEAK defaults, inline functions) stay
    # interposable, as without it; -Bsymbolic-functions would bind them too.
    ldflags = [ "-Wl,-Bsymbolic-non-weak-functions" ]
}

config("static_library") {
}

config("threads") {
    cflags = [ "-pthread" ]
    libs = [ "pthread" ]
}

config("std_string") {
    defines = [ "TSTRING_IS_STD_STRING" ]
}

config("ydb_embedded_nbs") {
    defines = [ "YDB_EMBEDDED_NBS_ENABLED" ]
}

config("no_custom_char_ptr_std_comparator") {
    defines = [ "NO_CUSTOM_CHAR_PTR_STD_COMPARATOR" ]
}

config("no_warnings") {
    cflags = [ "-Wno-everything" ]
}

# The UDF ABI of every module: the stable one, as ya's default (and
# YQL_ABI_VERSION / YQL_STABLE_ABI_VERSION / YQL_LAST_ABI_VERSION). All the
# objects of a binary have to agree on it (udf_version.h aborts the load
# otherwise). TODO: YQL_CURRENT_ABI_VERSION -- the current ABI of its whole
# closure, ya building every YQL_LIBRARY twice for it
config("yql_abi") {
    defines = [ "USE_STABLE_UDF_ABI_VERSION" ]
}

config("no_undefined") {
    ldflags = [ "-Wl,--no-undefined" ]
}

# The main key of ydb/core/blobstorage/crypto/default.h, defined by the
# program: see ydb_default_pdisk_sequence_weak.h. The private config of the
# libraries that refer to it pulls this one in. The -include goes to cc1: the
# PCH of a target (pch_mode = "per_target") is taken only from the first
# -include the driver sees.
config("ydb_default_pdisk_sequence_weak") {
    cflags = [
        "-Xclang",
        "-include",
        "-Xclang",
        rebase_path("ydb_default_pdisk_sequence_weak.h", root_build_dir),
    ]
}

if (current_toolchain == default_toolchain) {
    write_file("$root_build_dir/.gitignore", [ "*" ])
}
