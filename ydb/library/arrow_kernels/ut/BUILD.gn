unittest_executable("ut") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//library/cpp/testing/unittest",
    "//ydb/library/arrow_kernels",
    "//ydb/library/formats/arrow/helpers",
  ]

  sources = [
    "//ydb/library/arrow_kernels/ut_arithmetic.cpp",
    "//ydb/library/arrow_kernels/ut_common.cpp",
    "//ydb/library/arrow_kernels/ut_math.cpp",
    "//ydb/library/arrow_kernels/ut_round.cpp",
  ]

  include_dirs = [ "//ydb/library/arrow_kernels" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
