unittest_executable("ut_bridge") {
  deps = [
    "//contrib/libs/yaml-cpp",
    "//library/cpp/yaml/as",
    "//ydb/core/base",
    "//ydb/core/blobstorage/base",
    "//ydb/core/blobstorage/nodewarden",
    "//ydb/core/blobstorage/ut_blobstorage/lib",
    "//ydb/core/blobstorage/vdisk/huge",
    "//ydb/core/protos",
    "//ydb/core/tablet",
    "//ydb/core/tx/scheme_cache",
  ]

  sources = [
    "//ydb/core/blobstorage/ut_blobstorage/bridge_add_pile.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_assimilation.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_cluster_state.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_conversion.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_data_kind.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_decommit.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_failover.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_get.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_keep_flags.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_piles.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_rejoin.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_remove_pile.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_restart.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_routing.cpp",
    "//ydb/core/blobstorage/ut_blobstorage/bridge_syncer.cpp",
  ]

  include_dirs = [ "//ydb/core/blobstorage/ut_blobstorage" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
