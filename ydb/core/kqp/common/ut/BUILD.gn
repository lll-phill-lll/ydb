unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/kqp/common",
    "//ydb/core/kqp/topics",  # peerdir only
    "//ydb/core/kqp/ut/common",  # peerdir only
    "//ydb/core/scheme",
    "//ydb/core/scheme_types",
    "//yql/essentials/minikql",
    "//yql/essentials/minikql/invoke_builtins",
    "//yql/essentials/minikql/invoke_builtins/llvm16",  # peerdir only
    "//yql/essentials/minikql/runtime_settings",
    "//yql/essentials/minikql:alloc",
    "//yql/essentials/public/udf",
    "//yql/essentials/sql/pg_dummy",  # peerdir only
  ]

  sources = [
    "dynamic_function_registry_ut.cpp",
    "kqp_shard_meta_ut.cpp",
    "kqp_tli_ut.cpp",
    "kqp_tx_manager_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/kqp/common" ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
