unittest_executable("ut") {
  deps = [
    "//library/cpp/testing/unittest",
    "//ydb/core/mon:audit",
    "//ydb/core/util",  # peerdir only
  ]

  sources = [
    "//ydb/core/mon/audit/audit_ut.cpp",
    "//ydb/core/mon/audit/url_matcher_ut.cpp",
  ]

  include_dirs = [ "//ydb/core/mon/audit" ]

  link_select = [
    "YqlServicePolicy=stub",
    "allocator=tcmalloc",
    "minikql_codegen=no_llvm",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=wasm_default",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=no_llvm",
  ]
}
