unittest_executable("ut_retry") {
  deps = [
    "//contrib/libs/apache/arrow",
    "//library/cpp/testing/unittest",
    "//ydb/apps/ydbd/export",
    "//ydb/core/base",
    "//ydb/core/protos",
    "//ydb/core/testlib/actors",
    "//ydb/core/testlib/default",  # peerdir only
    "//ydb/core/tx/columnshard",
    "//ydb/core/tx/columnshard/backup:iscan",
    "//ydb/core/tx/datashard",
    "//ydb/core/wrappers",
    "//ydb/library/testlib/s3_recipe_helper",
  ]

  sources = [ "s3_retry_ut.cpp" ]

  include_dirs = [ "//ydb/core/tx/columnshard/backup/iscan" ]

  test_depends_unbuilt = [
    "//contrib/python/moto/bin",
    "//ydb/tests/tools/s3_recipe",
  ]

  link_select = [
    "YqlServicePolicy=exception_policy",
    "allocator=tcmalloc",
    "minikql_codegen=llvm16",
    "retro_spans=spans",
    "topic_rpc=persqueue_v1",
    "wasm=engine",
    "yql_pg_runtime=pg_dummy",
    "yql_pg_sql_translator=pg_dummy",
    "yt_codegen=llvm16",
  ]
}
